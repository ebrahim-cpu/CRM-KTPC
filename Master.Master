<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Master.master.cs" Inherits="CRM.Master" %>

<!DOCTYPE html>
<meta name="viewport">
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
